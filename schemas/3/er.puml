@startuml
title ER-диаграмма — Тёплый дом
hide circle
skinparam linetype ortho

package "БД управления пользователями" {
    entity "User\nusers" as users {
        * id : UUID <<PK>>
        --
        * login : VARCHAR <<UNIQUE>>
        * password_hash : TEXT
        * created_at : TIMESTAMPTZ
    }
}

package "БД управления устройствами" {
    entity "Location\nlocations" as locations {
        * id : UUID <<PK>>
        --
        * owner_id : UUID <<REF>>
        * name : VARCHAR
        * created_at : TIMESTAMPTZ
    }

    entity "DeviceType\ndevice_types" as device_types {
        * id : UUID <<PK>>
        --
        * code : VARCHAR <<UNIQUE>>
        * name : VARCHAR
    }

    entity "Device\ndevices" as devices {
        * id : UUID <<PK>>
        --
        * owner_id : UUID <<REF>>
        * type_id : UUID <<FK>>
        * location_id : UUID <<FK>>
        * name : VARCHAR
        serial_number : VARCHAR
        endpoint : TEXT
        * protocol : VARCHAR
        connection_config : JSONB
        * created_at : TIMESTAMPTZ
        deleted_at : TIMESTAMPTZ
    }

    entity "OutboxEvent\noutbox_devices" as outbox {
        * id : UUID <<PK>>
        --
        * device_id : UUID <<FK>>
        * type : VARCHAR
        * payload : JSONB
        * created_at : TIMESTAMPTZ
        published_at : TIMESTAMPTZ
    }
}

package "БД телеметрии" {
    entity "Device\ntelemetry_devices" as telemetry_devices {
        * device_id : UUID <<PK, REF>>
        --
        * owner_id : UUID <<REF>>
        endpoint : TEXT
        * protocol : VARCHAR
        connection_config : JSONB
        deleted_at : TIMESTAMPTZ
    }

    entity "TelemetryData\ntelemetry_data" as telemetry_data {
        * id : UUID <<PK>>
        --
        * device_id : UUID <<FK>>
        * metric : VARCHAR
        * value : JSONB
        unit : VARCHAR
        * received_at : TIMESTAMPTZ
    }

    entity "ProcessedEvent\nprocessed_events" as processed_events {
        * event_id : UUID <<PK>>
        --
        * processed_at : TIMESTAMPTZ
    }
}

users ||..o{ devices : владеет
users ||..o{ locations : владеет
locations ||--o{ devices : содержит
device_types ||--o{ devices : определяет тип
devices ||--o{ outbox : имеет события
devices ||..o| telemetry_devices : проекция по событиям
telemetry_devices ||--o{ telemetry_data : имеет показания

note right of processed_events
    event_id содержит идентификатор
    события, полученного из RabbitMQ.
    Используется для идемпотентной
    обработки сообщений.
end note

@enduml