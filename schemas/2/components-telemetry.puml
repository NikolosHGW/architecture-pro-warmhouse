@startuml
!include <C4/C4_Component>

title Диаграмма компонентов — Телеметрия

Container(bff, "BFF", "Go", "API для frontend")
ContainerDb(db, "База данных сервиса телеметрии", "PostgreSQL")
ContainerQueue(rabbit, "Брокер сообщений", "RabbitMQ", "События устройств")
System_Ext(user_devices, "Устройства")

Container_Boundary(telemetry, "Телеметрия") {
    Component(consumer, "Консьюмер", "Go", "Получает события об устройствах и в одной транзакции делает запись в таблицу событий и в таблицу устройств")
    
    Component(devices_repo, "Репозиторий устройств", "Go", "Делает запись в таблицу устройств")
    
    Component(events_repo, "Репозиторий событий", "Go", "Делает запись в таблицу событий для предотвращения дублей")
    
    Component(worker, "Воркер сбора телеметрии", "Go", "Опрашивает устройства по поддерживаемым ими протоколам и сохраняет показания")

    Component(telemetry_handler, "API телеметрии", "Go", "Принимает запросы на получение показаний устройств")

    Component(telemetry_service, "Сервисный слой телеметрии", "Go", "Предоставляет показания устройств")
    
    Component(telemetry_repo, "Репозиторий телеметрии", "Go", "Чтение и сохранение показаний устройств")
}

Rel(rabbit, consumer, "Доставляет события устройств", "AMQP")
Rel(consumer, devices_repo, "Записывает")
Rel(consumer, events_repo, "Записывает")
Rel(devices_repo, db, "SQL")
Rel(events_repo, db, "SQL")
Rel(worker, devices_repo, "Получает список устройств")
Rel(worker, user_devices, "Опрашивает устройства и получает показания", "Протоколы устройств")
Rel(worker, telemetry_repo, "Сохраняет показания устройств")
Rel(telemetry_repo, db, "SQL")
Rel(bff, telemetry_handler, "Запрашивает показания устройств", "gRPC")
Rel(telemetry_handler, telemetry_service, "Вызывает бизнес-логику")
Rel(telemetry_service, telemetry_repo, "Получает последние сохранённые показания")

@enduml