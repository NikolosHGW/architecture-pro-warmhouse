@startuml
!include <C4/C4_Component>

title Диаграмма компонентов — Видеонаблюдение

Container(web_client, "Фронтенд", "JS", "Запрашивает просмотр камеры и воспроизводит видео")
Container(bff, "BFF", "Go", "Передаёт запросы на просмотр и возвращает параметры воспроизведения")
Container(devices, "Управление устройствами", "Go", "Хранит сведения о камерах и параметры подключения")
System_Ext(user_devices, "Устройства", "Партнёрские камеры")

Container_Boundary(video, "Видеонаблюдение") {
    Component(video_handler, "API видеонаблюдения", "REST API (HTTP/JSON)", "Принимает запросы на просмотр камер")

    Component(video_service, "Сервисный слой видеонаблюдения", "Go", "Проверяет права доступа и организует просмотр камер")

    Component(camera_client, "Адаптер интеграции с камерами", "Go", "Взаимодействует с камерами через поддерживаемые интерфейсы")
}

Rel(web_client, bff, "Запрашивает просмотр камеры", "HTTPS")
Rel(bff, video_handler, "Передаёт запрос и проверенный ID пользователя", "REST API (HTTP/JSON)")
Rel(video_handler, video_service, "Запрашивает организацию просмотра")
Rel(video_service, devices, "Получает сведения о камере и её владельце", "REST API (HTTP/JSON)")
Rel(video_service, camera_client, "Запрашивает параметры подключения")
Rel(camera_client, user_devices, "Взаимодействует с камерой", "Поддерживаемый протокол")

@enduml
