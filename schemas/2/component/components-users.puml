@startuml
!include <C4/C4_Component>

title Диаграмма компонентов — Управление пользователями

Container(web_client, "фронтенд", "JS", "Регистрирует пользователя, выполняет вход и передаёт JWT в защищённых запросах")
Container(bff, "BFF", "Go", "Проверяет подпись JWT и передаёт проверенный ID пользователя микросервисам")
ContainerDb(db, "База данных для микросервиса Управление пользователями", "PostgreSQL", "Хранит данные пользователей")

Container_Boundary(auth, "Управление пользователями") {
    Component(auth_handler, "API регистрации и входа", "gRPC", "Принимает запросы, проверяет формат входных данных и возвращает JWT")

    Component(auth_service, "Сервисный слой пользователей", "Go", "Регистрирует пользователей, хеширует пароли и проверяет пароль при входе")

    Component(user_repo, "Репозиторий пользователей", "Go", "Сохраняет пользователей и получает пользователя с хешем пароля по логину")

    Component(jwt, "Выдача JWT", "Go", "Подписывает короткоживущий access token приватным ключом; включает sub (ID пользователя), exp, iss и aud")
}

Rel(web_client, bff, "Регистрируется / входит и получает JWT; затем передаёт Authorization: Bearer JWT", "HTTPS")
Rel(bff, auth_handler, "Передаёт запросы регистрации и входа", "gRPC")
Rel(auth_handler, auth_service, "Вызывает регистрацию или вход")
Rel(auth_service, user_repo, "Создаёт пользователя или получает данные для проверки пароля")
Rel(user_repo, db, "Читает и записывает", "SQL")
Rel(auth_service, jwt, "После успешного входа запрашивает JWT для ID пользователя")

@enduml