@startuml
!include <C4/C4_Component>

title Диаграмма компонентов — Видеонаблюдение

Container(web_client, "фронтенд", "JS", "Отправляет данные для WebRTC и устанавливает WebRTC-соединение с камерой")
Container(bff, "BFF", "Go", "Передаёт параметры WebRTC и данные аутентифицированного пользователя, возвращает ответ камеры фронтенду")
Container(devices, "микросервис - Управление устройствами", "Go", "Хранит владельцев камер и урл для WebRTC")
System_Ext(user_devices, "Устройства", "Камеры с WebRTC")

Container_Boundary(video, "Видеонаблюдение") {
    Component(video_handler, "API видеонаблюдения", "gRPC", "Принимает данные пользователя и данные WebRTC")

    Component(video_service, "Сервисный слой видеонаблюдения", "Go", "Получает параметры камеры, проверяет право пользователя на просмотр")

    Component(camera_client, "Клиент, который стучится к камере", "HTTPS", "Передаёт и возвращает данные для WebRTC")
}

Rel(web_client, bff, "Передаёт данные камеры и WebRTC, получает данные для WebRTC", "HTTPS")
Rel(bff, video_handler, "Передаёт запрос и данные аутентифицированного пользователя", "gRPC")
Rel(video_handler, video_service, "Запрашивает согласование WebRTC-подключения")
Rel(video_service, devices, "Получает владельца камеры и урл камеры", "gRPC")
Rel(video_service, camera_client, "После проверки доступа передаёт урл")
Rel(camera_client, user_devices, "Передаёт данные WebRTC", "HTTPS")
Rel(user_devices, web_client, "Камера передаёт видео по соединению, установленному браузером", "WebRTC")

@enduml
